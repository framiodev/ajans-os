{
  "manifestVersion": 5,
  "id": "com.framiomedia.ajansos.bridge",
  "name": "AjansOS Köprüsü",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "PS", "minVersion": "24.0.0" },
  "entrypoints": [
    {
      "type": "panel",
      "id": "ajansosPanel",
      "label": { "default": "AjansOS" },
      "minimumSize": { "width": 230, "height": 260 },
      "preferredDockedSize": { "width": 280, "height": 320 }
    }
  ],
  "requiredPermissions": {
    "network": { "domains": ["ws://localhost", "http://localhost", "localhost", "127.0.0.1"] },
    "localFileSystem": "fullAccess"
  }
}
