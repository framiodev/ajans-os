{
  "name": "framiomedia-ajansos",
  "version": "1.5.3",
  "description": "FramioMedia AjansOS Studio - Yapay Zeka Reklam Ajansi ve Adobe MCP",
  "author": "FramioMedia",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --no-warnings --test backend/test/*.test.mjs",
    "build:exe": "cd frontend && npm run build && cd .. && electron-builder --win nsis",
    "release": "cd frontend && npm run build && cd .. && electron-builder --win nsis --publish always"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "electron-updater": "^6.8.11",
    "express": "^5.1.0"
  },
  "devDependencies": {
    "electron": "^35.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.framiomedia.ajansos",
    "productName": "FramioMedia AjansOS",
    "asar": false,
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "framiodev",
        "repo": "ajans-os"
      }
    ],
    "files": [
      "electron/**/*",
      "backend/**/*",
      "mcp-servers/**/*",
      "design-memory/**/*",
      "frontend/dist/**/*",
      "package.json"
    ],
    "win": {
      "artifactName": "FramioMedia-AjansOS-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
